# What an ade release bundles, beside ade itself: one line per component,
# read by tools/mkrelease.sh.
#
#   <name> <version> <how>
#
# how is
#   github:<owner/repo>:<asset>[,<asset>...]   assets of the release tagged
#                                              v<version>, each a zip laid
#                                              out from the card's root or a
#                                              bare .bin for /bin; {v} is
#                                              the version
#
# "pending" as the version stops a release: the component has no release
# with what ade needs yet. VERSION_<name>=<v> overrides one for a trial run.
hub   0.6.0   github:avalonbits/hub:hub-{v}.zip,hub-acc-{v}.zip
aed   1.6.3   github:avalonbits/aed:aed-{v}.zip
acc   0.6.0   github:avalonbits/acc:acc-{v}.zip
zap   1.2.0   github:avalonbits/zap:zap.bin
ref   0.4.1   github:avalonbits/ref:ref-{v}.zip
